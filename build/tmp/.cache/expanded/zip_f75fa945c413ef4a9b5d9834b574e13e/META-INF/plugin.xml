<idea-plugin>
  <idea-version since-build="243.21565" until-build="243.*" />
  <version>0.1.0</version>
  <id>com.vio.panda_commit</id>
  <name>Panda Auto Commit</name>
  <vendor email="your.email@example.com" url="http://www.yourwebsite.com">Your Name</vendor>
  <description><![CDATA[Automates Git commit messages using Google's Gemini AI.]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.vcs</depends>
  <extensions defaultExtensionNs="com.intellij">
    <applicationService serviceImplementation="com.viotech.auto.GeminiSettingsState" />
    <applicationConfigurable parentId="tools" instance="com.viotech.auto.GeminiSettingsConfigurable" id="GeminiSettingsConfigurable" displayName="Gemini Commit Auto" />
  </extensions>
  <actions>
    <action id="PandaCommitAction" class="com.viotech.auto.GenerateCommitAction" text="Generate Commit Message with AI" description="Uses Gemini AI to generate a commit message">
      <add-to-group group-id="Vcs.MessageActionGroup" anchor="first" />
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt G" />
    </action>
  </actions>
</idea-plugin>
